{
  "lastChangelogVersion": "1.1.0",
  "defaultThinkingLevel": "high",
  "cacheWarming": "streaming",
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "global.anthropic.claude-opus-5-5",
  "enabledModels": [
    "amazon-bedrock/global.anthropic.claude-opus-5-5",
    "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
    "amazon-bedrock/global.anthropic.claude-opus-4-8",
    "amazon-bedrock/global.anthropic.claude-haiku-5-5",
    "amazon-bedrock/global.anthropic.claude-fable-5-1",
    "amazon-bedrock/global.anthropic.claude-fable-5",
    "kiro/*",
    "agnes/*",
    "deepseek/*"
  ],
  "theme": "paper-green/catppuccin-mocha",
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    {
      "source": "../../development/github.com/LEUNGUU/pi-agent-config",
      "extensions": [
        "extensions/*.ts",
        "+extensions/hindsight-mcp/index.ts",
        "+extensions/subagent/index.ts"
      ]
    },
    "git:https://github.com/badlogic/pi-diff-review",
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "skills": [
        "skills/ponytail-review",
        "skills/ponytail-audit"
      ]
    },
    "https://github.com/earendil-works/pi-transcribe",
    "git:github.com/kartikkabadi/pi-handoff"
  ],
  "tuiMode": "fullscreen"
}

#!/bin/sh
# Block commits that stage secrets. This repo is public.
#
# Install: setup.sh links this into .git/hooks/pre-commit. It sits in
# .git/hooks rather than core.hooksPath because Code Defender already owns
# core.hooksPath on corp machines and chains to .git/hooks from there.
#
# Bypass a false positive for one commit: git commit --no-verify
# Allow a value permanently: add its fingerprint to .gitleaksignore

# Non-interactive shells (ssh 'git commit ...') skip ~/.local/bin.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks not installed — refusing to commit unscanned." >&2
	echo "  macOS: brew install gitleaks   Linux: see README" >&2
	exit 1
fi

exec gitleaks git --staged --no-banner --redact --verbose
